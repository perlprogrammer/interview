# Bu faylı `.env` adı ilə kopyalayın və dəyərləri doldurun.
# `.env` .gitignore-dadır — HEÇ VAXT repoya salınmamalıdır.

# ---- Claude API ----
ANTHROPIC_API_KEY=
# Müsahibə gedişi — sürət vacibdir
MODEL=claude-sonnet-5
# Yekun hesabat — keyfiyyət vacibdir
REPORT_MODEL=claude-opus-5

# ---- Veb server ----
PORT=5000

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=musahibe

# ---- Müsahibə ----
# Hər bacarıq üçün neçə sual verilsin
QUESTIONS_PER_SKILL=2
# Yeni namizəd formasındakı default müddət (dəqiqə)
INTERVIEW_MINUTES=15
# Admin sessiyasının müddəti (saat)
SESSION_HOURS=8
