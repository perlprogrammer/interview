# systemd unit — müsahibə platformasını avtomatik işə salır və yenidən qaldırır
#
# Quraşdırma:
#   sudo cp /home/musahibe/musahibe/deploy/musahibe.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now musahibe
#   systemctl status musahibe
#   journalctl -u musahibe -f          # logları izləmək

[Unit]
Description=AI Musahibe Platformasi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=musahibe
Group=musahibe
WorkingDirectory=/home/musahibe/musahibe
ExecStart=/home/musahibe/musahibe/.venv/bin/python /home/musahibe/musahibe/app.py
Restart=always
RestartSec=5

# Təhlükəsizlik
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/musahibe/musahibe

[Install]
WantedBy=multi-user.target
